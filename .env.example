# Prompt Vault configuration (all optional). Copy to .env to use.
PV_HOST=127.0.0.1
PV_PORT=8080
PV_DATA_DIR=~/.promptvault
# PV_DATABASE_URL=sqlite:///~/.promptvault/promptvault.db
PV_LOG_LEVEL=info
PV_SEED_ON_START=true
# PV_CORS_ORIGINS=["http://localhost:5173"]
PV_TRASH_RETENTION_DAYS=30
# URL importers (github, url, huggingface)
# PV_GITHUB_TOKEN=            # raises the GitHub API rate limit; sent only to GitHub hosts
# PV_IMPORT_ALLOW_PRIVATE_HOSTS=wiki.corp,10.1.0.0/16   # exact hosts/IPs/CIDRs; empty = none
# PV_IMPORT_FETCH_TIMEOUT=30
# PV_IMPORT_FETCH_MAX_BYTES=5242880
# PV_IMPORT_GITHUB_MAX_FILES=200
