# Prompt Vault configuration (all optional). Copy to .env to use.
PV_HOST=127.0.0.1
PV_PORT=8080
PV_DATA_DIR=~/.promptvault
# PV_DATABASE_URL=sqlite:///~/.promptvault/promptvault.db
PV_LOG_LEVEL=info
PV_SEED_ON_START=true
# PV_CORS_ORIGINS=["http://localhost:5173"]
PV_TRASH_RETENTION_DAYS=30
# URL importers (github, url, huggingface)
# PV_GITHUB_TOKEN=            # raises the GitHub API rate limit; sent only to GitHub hosts
# PV_IMPORT_ALLOW_PRIVATE_HOSTS=wiki.corp,10.1.0.0/16   # exact hosts/IPs/CIDRs; empty = none
# PV_IMPORT_FETCH_TIMEOUT=30
# PV_IMPORT_FETCH_MAX_BYTES=5242880
# PV_IMPORT_GITHUB_MAX_FILES=200
# Export (CSV, XLSX, JSON, Markdown ZIP)
# PV_EXPORT_MAX_ROWS=50000     # prompts per API export; a larger selection answers 413
# Docker Compose (docker/docker-compose.yml, docker/compose.postgres.yml)
# PV_TAG=edge                 # image tag: edge, a version like 1.0.0, or latest
# PV_BIND=127.0.0.1         # host address the port is published on (no auth in v1: keep loopback)
# PV_HOST_PORT=8080
# PostgreSQL variant (EXPERIMENTAL). Use a URL-safe password (letters, digits, - _ . ~)
# POSTGRES_USER=promptvault
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=promptvault
# PV_DATABASE_URL=postgresql+psycopg://promptvault:change-me@localhost:5432/promptvault   # outside Compose
