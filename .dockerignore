# Keep the build context small: only backend/, frontend/, seed/ and docker/ are used
.git
.github
.gitattributes
.gitignore
.env
.env.*
!.env.example
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.tsbuildinfo
frontend/dist
backend/src/promptvault/static
backend/tests
backend/dist
docs
tools
*.db
*.db-wal
*.db-shm
*.md
!seed/**
